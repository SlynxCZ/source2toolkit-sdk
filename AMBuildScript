# vim: set sts=2 ts=8 sw=2 tw=99 et ft=python:
#
# Buildable two ways:
#  - Standalone (configure.py + ambuild): detects an SDK itself and builds the
#    static library on its own.
#  - As a sub-build from a plugin's own AMBuildScript, the way this repo's
#    vendor/sourcehook/AMBuildScript is pulled in:
#
#      ToolkitSdk = builder.Build('<sdk path>/AMBuildScript', {
#        'ToolkitSdkTarget': sdk_target,     # the caller's own sdk_target,
#        'ToolkitSdkHelpers': SdkHelpers,    # so the SDK is not detected twice
#      })
#      ...
#      ToolkitSdk['config'].AddPublicIncludes(binary)
#      binary.compiler.linkflags += [ToolkitSdk['binaries_by_arch'][cxx.target.arch]]
#
#    AddPublicIncludes() is the point: it adds every include path a consumer of
#    "source2toolkit/IToolkitPlugin.h" needs -- public/, the hl2sdk tree and
#    sourcehook -- in one call, computed from *this* repo's own directory, so a
#    caller never hand-lists the SDK's folder layout and re-breaks every time it
#    changes.
import os, sys

# Injected by a parent build; None when standalone.
ToolkitSdkTarget = globals().get('ToolkitSdkTarget', None)
ToolkitSdkHelpers = globals().get('ToolkitSdkHelpers', None)


def ResolveEnvPath(env, folder):
  if env in os.environ:
    path = os.environ[env]
    if os.path.isdir(path):
      return path
  else:
    head = os.getcwd()
    oldhead = None
    while head != None and head != oldhead:
      path = os.path.join(head, folder)
      if os.path.isdir(path):
        return path
      oldhead = head
      head, tail = os.path.split(head)
  return None


class ToolkitSdkConfig(object):
  def __init__(self):
    # Snapshot now, while this repo's own AMBuildScript is the currently
    # executing context -- builder.currentSourcePath is a live attribute that
    # ambuild2 mutates as it walks in and out of each BuildScript, so reading it
    # lazily from inside AddPublicIncludes() would point at whichever project
    # happens to be calling. Same reasoning as vendor/sourcehook/AMBuildScript.
    self.sourcePath = builder.currentSourcePath

    self.all_targets = []
    self.binaries = []
    self.binaries_by_arch = {}
    self.sdks = {}
    self.sdk_manifests = []
    self.sdk_targets = []

    if ToolkitSdkTarget is not None:
      # Reuse the caller's compiler and SDK; detecting our own would configure
      # the same SDK twice in one build.
      self.all_targets = [ToolkitSdkTarget.cxx]
      self.sdk_targets = [ToolkitSdkTarget]
      return

    if builder.options.targets:
      target_archs = builder.options.targets.split(',')
    else:
      target_archs = ['x86_64']

    for arch in target_archs:
      try:
        cxx = builder.DetectCxx(target_arch=arch)
      except Exception as e:
        if builder.options.targets:
          raise
        print('Skipping target {}: {}'.format(arch, e))
        continue
      self.all_targets.append(cxx)

    if not self.all_targets:
      raise Exception('No suitable C/C++ compiler was found.')

  def findSdkPath(self, sdk_name):
    dir_name = 'hl2sdk-{}'.format(sdk_name)
    if builder.options.hl2sdk_root:
      sdk_path = os.path.join(builder.options.hl2sdk_root, dir_name)
      if os.path.exists(sdk_path):
        return sdk_path
    return ResolveEnvPath('HL2SDK{}'.format(sdk_name.upper()), dir_name)

  def detectSDKs(self):
    global SdkHelpers

    if ToolkitSdkHelpers is not None:
      SdkHelpers = ToolkitSdkHelpers
      self.sdks = SdkHelpers.sdks
      self.sdk_manifests = SdkHelpers.sdk_manifests
      return

    # hl2sdk-manifests ships with the SDK (vendor/hl2sdk-manifests), the same
    # way metamod-source carries its own copy, so --hl2sdk-manifests is only
    # there to point at a different checkout.
    manifests = builder.options.hl2sdk_manifests
    if not manifests:
      manifests = os.path.join(self.sourcePath, 'vendor', 'hl2sdk-manifests')

    if not os.path.isdir(manifests):
      raise Exception('Could not find a source copy of HL2SDK manifests -- run '
                      'git submodule update --init --recursive, or pass '
                      '--hl2sdk-manifests')

    SdkHelpers = builder.Eval(
      os.path.join(manifests, 'SdkHelpers.ambuild'),
      {'Project': 'metamod'})

    sdk_list = [s for s in builder.options.sdks.split(',') if s]
    SdkHelpers.find_sdk_path = self.findSdkPath
    SdkHelpers.findSdks(builder, self.all_targets, sdk_list)

    self.sdks = SdkHelpers.sdks
    self.sdk_manifests = SdkHelpers.sdk_manifests
    self.sdk_targets = SdkHelpers.sdk_targets

    if len(self.sdks) > 1:
      raise Exception('Only one sdk at a time is supported.')

  def configure(self):
    if ToolkitSdkTarget is not None:
      # The caller already configured its own compiler; leave it alone.
      return

    for cxx in self.all_targets:
      if cxx.target.arch not in ['x86', 'x86_64']:
        raise Exception('Unknown target architecture: {0}'.format(cxx.target.arch))
      self.configure_cxx(cxx)

  def configure_cxx(self, cxx):
    if cxx.behavior == 'gcc':
      cxx.defines += [
        'stricmp=strcasecmp',
        '_stricmp=strcasecmp',
        '_snprintf=snprintf',
        '_vsnprintf=vsnprintf',
        'HAVE_STDINT_H',
        'GNUC',
      ]
      cxx.cflags += [
        '-pipe',
        '-fno-strict-aliasing',
        '-Wall',
        '-Wno-uninitialized',
        '-Wno-unused',
        '-Wno-switch',
        '-Wno-parentheses',
        '-Wno-invalid-offsetof',
        '-msse',
        '-fPIC',
      ]
      cxx.cxxflags += [
        '-std=c++20',
        '-frtti',
        '-fno-threadsafe-statics',
        '-Wno-non-virtual-dtor',
        '-Wno-overloaded-virtual',
        '-Wno-register',
      ]
      if cxx.family == 'gcc':
        cxx.cflags += ['-mfpmath=sse']
      if cxx.family == 'clang':
        cxx.cxxflags += [
          '-Wno-implicit-exception-spec-mismatch',
          '-Wno-inconsistent-missing-override',
        ]
    elif cxx.like('msvc'):
      if builder.options.debug == '1':
        cxx.cflags += ['/MTd']
        cxx.linkflags += ['/NODEFAULTLIB:libcmt']
      else:
        cxx.cflags += ['/MT']
      cxx.defines += [
        '_CRT_SECURE_NO_DEPRECATE',
        '_CRT_SECURE_NO_WARNINGS',
        '_CRT_NONSTDC_NO_DEPRECATE',
      ]
      cxx.cflags += ['/W3', '/Zi', '/EHsc', '/std:c++20', '/bigobj']
      cxx.cxxflags += ['/TP']

    if builder.options.opt == '1':
      cxx.defines += ['NDEBUG']
      if cxx.behavior == 'gcc':
        cxx.cflags += ['-O3']
      elif cxx.behavior == 'msvc':
        cxx.cflags += ['/Ox', '/Zo']

    if builder.options.debug == '1':
      cxx.defines += ['DEBUG', '_DEBUG']
      if cxx.behavior == 'gcc':
        cxx.cflags += ['-g3']
      elif cxx.behavior == 'msvc':
        cxx.cflags += ['/Od', '/RTC1']

    if cxx.target.platform == 'linux':
      cxx.defines += [
        '_LINUX', 'LINUX', 'POSIX', '_FILE_OFFSET_BITS=64',
        # Matches CMakeLists.txt -- every consumer has to agree with the SDK
        # here or std::string crosses the boundary with two different layouts.
        '_GLIBCXX_USE_CXX11_ABI=0',
      ]
      if cxx.family == 'gcc':
        cxx.linkflags += ['-static-libgcc']
      elif cxx.family == 'clang':
        cxx.linkflags += ['-lgcc_eh']
      cxx.linkflags += ['-static-libstdc++']
    elif cxx.target.platform == 'windows':
      cxx.defines += ['WIN32', '_WINDOWS']

    cxx.defines += ['META_IS_SOURCE2', 'X64BITS', 'PLATFORM_64BITS', '_ITERATOR_DEBUG_LEVEL=0']

  def AddPublicIncludes(self, binary):
    # The one call a consumer of "source2toolkit/IToolkitPlugin.h" needs:
    # public/ for the toolkit headers, and sourcehook because IToolkitPlugin.h
    # includes "sourcehook.h" itself. The hl2sdk include paths come from
    # SdkHelpers.configureCxx() on the consumer's own binary.
    binary.compiler.cxxincludes += [
      os.path.join(self.sourcePath, 'public'),
      os.path.join(self.sourcePath, 'vendor', 'sourcehook', 'include'),
      os.path.join(self.sourcePath, 'vendor', 'sourcehook', 'vendor'),
      os.path.join(self.sourcePath, 'vendor', 'sourcehook', 'vendor', 'safetyhook'),
      os.path.join(self.sourcePath, 'vendor', 'sourcehook', 'vendor', 'tl'),
      os.path.join(self.sourcePath, 'vendor', 'sourcehook', 'vendor', 'zydis'),
    ]

  def AddSdkIncludes(self, binary, sdk):
    # The manifests know each SDK's include list and the defines its headers
    # expect (COMPILER_GCC and friends -- without them public/tier0/platform.h
    # reaches for a Windows <new.h>), so let them do it rather than hand-listing
    # folders here.
    SdkHelpers.configureCxx(builder, binary, sdk)

    # Folders the toolkit headers reach into by bare name that are not in the
    # manifests' own include list. Kept in step with CMakeLists.txt.
    binary.compiler.cxxincludes += [
      os.path.join(sdk['path'], 'public', 'schemasystem'),
      os.path.join(sdk['path'], 'public', 'entity2'),
      os.path.join(sdk['path'], 'public', 'mathlib'),
      os.path.join(sdk['path'], 'public', 'tier0'),
      os.path.join(sdk['path'], 'public', 'tier1'),
      os.path.join(sdk['path'], 'game', 'server'),
      os.path.join(sdk['path'], 'thirdparty', 'protobuf-3.21.8', 'src'),
    ]

  def ProtoSources(self, sdk_target):
    proto_dir = os.environ.get('CSGO_PROTO')
    if not proto_dir:
      raise Exception('CSGO_PROTO is not set')

    names = [
      'network_connection', 'networkbasetypes', 'cs_gameevents', 'cs_usercmd',
      'base_gcmessages', 'econ_gcmessages', 'engine_gcmessages', 'gcsdk_gcmessages',
      'gcsystemmsgs', 'cstrike15_gcmessages', 'cstrike15_usermessages',
      'source2_steam_stats', 'netmessages', 'networksystem_protomessages',
      'steammessages', 'usercmd', 'usermessages', 'gameevents', 'clientmessages',
      'te', 'valveextensions',
    ]
    return [os.path.join(proto_dir, '{}.proto'.format(n)) for n in names]

  def Library(self, cxx, name):
    return cxx.StaticLibrary(name)

  def build(self):
    for sdk_target in self.sdk_targets:
      sdk = sdk_target.sdk
      cxx = sdk_target.cxx

      lib = self.Library(cxx, 'source2toolkit-sdk')

      self.AddPublicIncludes(lib)
      self.AddSdkIncludes(lib, sdk)
      lib.compiler.cxxincludes += [os.path.join(self.sourcePath, 'src')]

      for other_sdk in self.sdk_manifests:
        lib.compiler.defines += ['SE_{}={}'.format(other_sdk['define'], other_sdk['code'])]

      for root, _, files in os.walk(os.path.join(self.sourcePath, 'src')):
        for f in files:
          if f.endswith('.cpp'):
            lib.sources += [os.path.relpath(os.path.join(root, f), self.sourcePath)]

      # The hl2sdk translation units the toolkit needs compiled in, matching
      # CMakeLists.txt. A plugin must not compile these again.
      lib.sources += [
        os.path.join(sdk['path'], 'public', 'tier0', 'memoverride.cpp'),
        os.path.join(sdk['path'], 'tier1', 'keyvalues3.cpp'),
        os.path.join(sdk['path'], 'tier1', 'convar.cpp'),
        os.path.join(sdk['path'], 'entity2', 'entityidentity.cpp'),
        os.path.join(sdk['path'], 'entity2', 'entitysystem.cpp'),
        os.path.join(sdk['path'], 'entity2', 'entitykeyvalues.cpp'),
      ]

      lib.custom = [builder.tools.Protoc(protoc=sdk_target.protoc,
                                         sources=self.ProtoSources(sdk_target))]

      node = builder.Add(lib)
      self.binaries += [node]
      self.binaries_by_arch[cxx.target.arch] = node.binary


ToolkitSdk = ToolkitSdkConfig()
ToolkitSdk.detectSDKs()
ToolkitSdk.configure()
ToolkitSdk.build()

# What a parent build gets back: the compiled-library paths (same {arch: path}
# convention as vendor/sourcehook/AMBuildScript), plus the config object so the
# caller can call ToolkitSdk['config'].AddPublicIncludes(binary) instead of
# re-declaring the SDK's folder layout by hand.
rvalue = {
  'binaries_by_arch': ToolkitSdk.binaries_by_arch,
  'config': ToolkitSdk,
}
